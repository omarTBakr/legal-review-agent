# S3-compatible storage credentials (iDrive e2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=

# Buckets
S3_PDF_BUCKET=temporalpdfs
S3_PARSED_MDS=parsedmds

# Local scratch space
# PDFs land in  <TEMP_PD_DIR>/<TEMP_PDF_FOLDER>
# Markdown lands in <TEMP_PD_DIR>/<TEMP_MD_FOLDER>
TEMP_PD_DIR=assets
TEMP_PDF_FOLDER=TEMP_PDF
TEMP_MD_FOLDER=TEMP_MD

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=process_pdf_queue

# Run the worker inside the API process, so `uv run main.py` is enough on its
# own. Convenient locally; leave it false in production and run workers/ apart
# so a slow parse cannot starve request handling and work survives an API restart.
RUN_WORKER_IN_API=false

# Logging
LOG_LEVEL=INFO

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legal advice pipeline
S3_LEGAL_ADVICE=legaladvice
# everything a project owns: its documents, their text, advice, chats and audio
S3_PROJECTS=projects
LEGAL_TASK_QUEUE=legal_advice_queue
LEGAL_MAX_CONCURRENT_PDFS=10
LEGAL_PAGES_PER_BATCH=30
LEGAL_MAX_PDFS=20
HUMAN_INPUT_TIMEOUT_SECONDS=3600

# Emailed reports; with no SMTP_HOST a review simply does not send one
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30

# Voice chat; the models run in voice/ as their own service
VOICE_SERVICE_URL=http://127.0.0.1:8100
VOICE_TIMEOUT_SECONDS=120
ASR_PROVIDER=voice_service
TTS_PROVIDER=voice_service
TTS_VOICE=Ryan
TTS_LANGUAGE=English
CHAT_CONTEXT_CHARACTERS=12000
